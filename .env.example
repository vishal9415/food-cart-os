# Public browser configuration (safe with Row Level Security enabled)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public web origin used to generate customer QR codes in the native owner app.
VITE_PUBLIC_APP_URL=https://your-domain.example

# Never put Supabase secret/service-role keys or payment credentials in VITE_* variables.
